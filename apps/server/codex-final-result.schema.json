{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schemas/codex-final-result-v1.json",
  "title": "Phantom Codex Final Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "summary",
    "completedItems",
    "incompleteItems",
    "failureCategory",
    "failureReason",
    "retryRecommended",
    "commitSha",
    "pushed"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "status": { "enum": ["completed", "incomplete", "failed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "completedItems": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "incompleteItems": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "failureCategory": {
      "enum": [
        "none",
        "task",
        "environment",
        "authentication",
        "rate_limit",
        "timeout",
        "cancelled",
        "malformed_output"
      ]
    },
    "failureReason": { "type": ["string", "null"], "maxLength": 8000 },
    "retryRecommended": { "type": "boolean" },
    "commitSha": {
      "anyOf": [{ "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" }, { "type": "null" }]
    },
    "pushed": { "type": "boolean" }
  }
}
